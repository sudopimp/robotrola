<?xml version="1.0"?>
<robot name="robotrola_r01" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="mesh_prefix" value="package://robotrola_description/meshes" />
  <link name="base_link"/>
  <link name="pelvis_link"><visual><geometry><mesh filename="${mesh_prefix}/pelvis_frame.stl" scale="0.001 0.001 0.001"/></geometry></visual></link>
  <joint name="base_to_pelvis" type="fixed"><parent link="base_link"/><child link="pelvis_link"/><origin xyz="0 0 0.9" rpy="0 0 0"/></joint>
  <link name="torso_link"><visual><geometry><mesh filename="${mesh_prefix}/torso_front_shell.stl" scale="0.001 0.001 0.001"/></geometry></visual></link>
  <joint name="pelvis_to_torso" type="fixed"><parent link="pelvis_link"/><child link="torso_link"/><origin xyz="0 0 0.25" rpy="0 0 0"/></joint>
  <link name="head_link"><visual><geometry><mesh filename="${mesh_prefix}/head_shell_front.stl" scale="0.001 0.001 0.001"/></geometry></visual></link>
  <joint name="neck_yaw" type="revolute"><parent link="torso_link"/><child link="head_link"/><origin xyz="0 0 0.34" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-0.9" upper="0.9" effort="0.5" velocity="0.25"/></joint>
  <link name="left_upper_arm_link"><visual><geometry><mesh filename="${mesh_prefix}/upper_arm_shell.stl" scale="0.001 0.001 0.001"/></geometry></visual></link>
  <joint name="left_shoulder_pitch" type="revolute"><parent link="torso_link"/><child link="left_upper_arm_link"/><origin xyz="0.16 0 0.21" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="-1.2" upper="1.2" effort="1.2" velocity="0.2"/></joint>
  <link name="left_forearm_link"><visual><geometry><mesh filename="${mesh_prefix}/forearm_shell.stl" scale="0.001 0.001 0.001"/></geometry></visual></link>
  <joint name="left_elbow" type="revolute"><parent link="left_upper_arm_link"/><child link="left_forearm_link"/><origin xyz="0 0 -0.18" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="0" upper="2.1" effort="0.8" velocity="0.25"/></joint>
</robot>
