<?xml version="1.0"?>
<robot name="robotrola_r01" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="mesh_prefix" value="package://robotrola_description/meshes" />
  <!-- Robotrola R-01 full-body research description: 42 revolute DOF -->
  <link name="base_link"/>
  <link name="pelvis_link">
    <visual><geometry><mesh filename="${mesh_prefix}/pelvis_frame.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.25 0.2 0.12"/></geometry></collision>
  </link>
  <joint name="base_to_pelvis" type="fixed">
    <parent link="base_link"/><child link="pelvis_link"/>
    <origin xyz="0 0 0.95" rpy="0 0 0"/>
  </joint>
  <link name="waist_link">
    <visual><geometry><mesh filename="${mesh_prefix}/pelvis_frame.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><cylinder radius="0.04" length="0.08"/></geometry></collision>
  </link>
  <joint name="waist_yaw" type="revolute">
    <parent link="pelvis_link"/><child link="waist_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="2.0" velocity="0.2"/>
  </joint>
  <link name="torso_link">
    <visual><geometry><mesh filename="${mesh_prefix}/torso_front_shell.stl" scale="0.001 0.001 0.001"/></geometry></visual>
